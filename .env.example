# ==========================================
# CogniFlow AI: Environment Variables
# Hackathon Configuration (Lenovo LEAP AI Hackathon 2026)
# ==========================================

# Groq Cloud AI Engine (Ultra-low latency LPU)
# Get your free key at https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_REASONING_MODEL=deepseek-r1-distill-llama-70b

# Supabase PostgreSQL & Auth Credentials
# Get your project keys at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret

# Real-Time WebSocket Server
NEXT_PUBLIC_WS_URL=http://localhost:4000
PORT=3000
WS_PORT=4000

# Security & Session Secrets
JWT_SECRET=super_secret_jwt_hmac_cogniflow_2026_salt
NODE_ENV=development
